{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Version PostgreSQL vector image tags",
      "matchPackageNames": [
        "pgvector/pgvector"
      ],
      "versioning": "regex:^(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-pg(?<major>\\d+)-(?<compatibility>bookworm)$"
    },
    {
      "description": "Version VectorChord image tags",
      "matchPackageNames": [
        "tensorchord/vchord-scratch"
      ],
      "versioning": "regex:^pg(?<major>\\d+)-v(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "Group PostgreSQL runtime updates",
      "matchPackageNames": [
        "pgvector/pgvector",
        "tensorchord/vchord-scratch"
      ],
      "groupName": "postgres runtime"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true
    }
  ]
}
